  "engines": {
    "node": "22.x",
    "npm": ">=10"
  },
  "scripts": {
    "dev": "tsx server.ts",
    "build": "npm run typecheck && vite build",
    "postbuild": "node --import tsx scripts/generate-discovery-files.mjs",
